{
  "name": "factory-template",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "next typegen && tsc --noEmit",
    "lint": "biome check --error-on-warnings .",
    "fix": "biome check --write .",
    "arch": "depcruise src --config .dependency-cruiser.cjs",
    "deadcode": "knip",
    "test": "vitest run",
    "e2e": "playwright test",
    "e2e:app": "pnpm db:migrate && pnpm build && pnpm start",
    "check": "pnpm typecheck && pnpm lint && pnpm arch && pnpm deadcode && pnpm test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:local": "pglite-server --db=./.pglite --port=5433 --max-connections=10",
    "prepare": "lefthook install"
  },
  "dependencies": {
    "@t3-oss/env-nextjs": "0.13.11",
    "better-auth": "1.7.27",
    "drizzle-orm": "0.45.4",
    "next": "16.4.6",
    "pg": "8.23.1",
    "pino": "10.4.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "resend": "6.39.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-conventional": "21.2.4",
    "@commitlint/types": "21.2.3",
    "@electric-sql/pglite": "0.5.17",
    "@electric-sql/pglite-socket": "0.2.20",
    "@playwright/test": "1.65.1",
    "@tailwindcss/postcss": "4.3.5",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "dependency-cruiser": "18.8.0",
    "drizzle-kit": "0.31.11",
    "knip": "6.47.0",
    "lefthook": "2.2.2",
    "tailwindcss": "4.3.5",
    "typescript": "6.0.3",
    "vite": "8.3.8",
    "vitest": "5.1.1"
  }
}
