# Copy to .env.local (gitignored). Every key here must also be declared in src/platform/env.ts.

# Local: run `pnpm db:local` (PGlite, no Docker) and keep this value. Production: your Neon/Supabase pooled URL.
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5433/postgres?sslmode=disable

# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Optional. Without a key, emails are kept in memory and logged instead of sent.
RESEND_API_KEY=
EMAIL_FROM=

# trace | debug | info | warn | error
LOG_LEVEL=info
